* text=auto eol=lf

# Binary assets through Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text

# Except what the site serves: Vercel clones without LFS, so public/ holds the
# real files (small, pre-sized images). A test in tests/lib/content.test.ts
# fails if anything here is tracked by LFS again.
public/** !filter !diff !merge binary
